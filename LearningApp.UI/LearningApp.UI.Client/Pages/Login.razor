@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager Navigation
@inject HttpClient Http
@inject BffAuthenticationStateProvider AuthStateProvider
@using System.Net.Http.Json
@using LearningApp.UI.Shared.Auth
@using LearningApp.UI.Shared.Common

<PageTitle>Login</PageTitle>

<div class="login-panel">
    <h1>LearningApp</h1>
    <p class="text-muted">Sign in with Microsoft or use a LearningApp account.</p>

    <div class="auth-tabs">
        <button type="button" class="btn @(mode == AuthMode.Login ? "btn-primary" : "btn-outline-primary")" @onclick="() => mode = AuthMode.Login">Email login</button>
        <button type="button" class="btn @(mode == AuthMode.Register ? "btn-primary" : "btn-outline-primary")" @onclick="() => mode = AuthMode.Register">Register</button>
    </div>

    <ErrorAlert Errors="@errors" />

    @if (mode == AuthMode.Login)
    {
        <EditForm Model="@loginForm" OnValidSubmit="LocalLoginAsync">
            <DataAnnotationsValidator />
            <label>Email</label>
            <InputText class="form-control" @bind-Value="loginForm.Email" />
            <ValidationMessage For="() => loginForm.Email" />

            <label>Password</label>
            <InputText type="password" class="form-control" @bind-Value="loginForm.Password" />
            <ValidationMessage For="() => loginForm.Password" />

            <button class="btn btn-primary w-100" disabled="@isBusy">Sign in</button>
        </EditForm>
    }
    else
    {
        <EditForm Model="@registerForm" OnValidSubmit="RegisterAsync">
            <DataAnnotationsValidator />
            <label>Full name</label>
            <InputText class="form-control" @bind-Value="registerForm.FullName" />
            <ValidationMessage For="() => registerForm.FullName" />

            <label>Email</label>
            <InputText class="form-control" @bind-Value="registerForm.Email" />
            <ValidationMessage For="() => registerForm.Email" />

            <label>Password</label>
            <InputText type="password" class="form-control" @bind-Value="registerForm.Password" />
            <ValidationMessage For="() => registerForm.Password" />

            <button class="btn btn-primary w-100" disabled="@isBusy">Create learner account</button>
        </EditForm>
    }

    <div class="auth-divider"><span>or</span></div>
    <button class="btn btn-outline-primary w-100" @onclick="BeginMicrosoftLogin">Sign in with Microsoft</button>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private enum AuthMode { Login, Register }

    private AuthMode mode = AuthMode.Login;
    private LoginRequest loginForm = new();
    private RegisterRequest registerForm = new();
    private IReadOnlyCollection<string> errors = Array.Empty<string>();
    private bool isBusy;

    private void BeginMicrosoftLogin()
    {
        var returnUrl = string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl;
        Navigation.NavigateTo($"/bff/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }

    private async Task LocalLoginAsync()
    {
        await SubmitAsync("bff/local-login", loginForm);
    }

    private async Task RegisterAsync()
    {
        await SubmitAsync("bff/register", registerForm);
    }

    private async Task SubmitAsync<TRequest>(string path, TRequest request)
    {
        isBusy = true;
        errors = Array.Empty<string>();

        try
        {
            using var response = await Http.PostAsJsonAsync(path, request);
            if (response.IsSuccessStatusCode)
            {
                AuthStateProvider.Refresh();
                Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "/" : ReturnUrl);
                return;
            }

            var error = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();
            errors = error?.Errors?.Count > 0
                ? error.Errors
                : new[] { error?.Message ?? $"Sign-in failed with HTTP {(int)response.StatusCode}." };
        }
        catch (Exception ex)
        {
            errors = new[] { ex.Message };
        }
        finally
        {
            isBusy = false;
        }
    }
}
